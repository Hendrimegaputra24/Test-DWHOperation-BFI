# Salin menjadi .env:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
POSTGRES_USER=pricer
POSTGRES_PASSWORD=pricer_pass
POSTGRES_DB=price_analytics

# Port database di komputer host. 5433 menghindari bentrok dengan PostgreSQL lokal di 5432.
DB_PORT=5433

# Nilai DEMO untuk percobaan lokal. Ganti sebelum dipakai di tempat lain.
API_JWT_SECRET=demo-only-secret-0123456789abcdef0123456789abcdef
API_ADMIN_PASSWORD=admin-demo-password
API_ANALYST_PASSWORD=analyst-demo-password
