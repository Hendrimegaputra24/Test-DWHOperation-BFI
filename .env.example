# Salin menjadi .env:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
POSTGRES_USER=pricer
POSTGRES_PASSWORD=pricer_pass
POSTGRES_DB=price_analytics

# Port database di komputer host. 5433 menghindari bentrok dengan PostgreSQL lokal di 5432.
DB_PORT=5433

# Nilai DEMO untuk percobaan lokal. Ganti sebelum dipakai di tempat lain.
API_JWT_SECRET=demo-only-secret-0123456789abcdef0123456789abcdef
API_ADMIN_PASSWORD=admin-demo-password
API_ANALYST_PASSWORD=analyst-demo-password

# Akun database khusus-baca (hanya schema gold) untuk Metabase. Dibuat otomatis oleh pipeline.
METABASE_DB_USER=metabase_ro
METABASE_DB_PASSWORD=metabase-demo-password

# Sumber data: sample (bawaan) | live | auto (coba crawl; bila gagal memakai sampel)
SOURCE_MODE=sample
# Wajib untuk mode live/auto: kontak (email atau URL) yang dicantumkan di User-Agent crawler
CRAWLER_CONTACT=

# --- Airflow (opsional): docker compose --profile airflow up -d --build ---
# Port UI di komputer Anda (8088 agar tidak bentrok dengan Airflow lain di 8080)
AIRFLOW_PORT=8088
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=airflow-demo-password
